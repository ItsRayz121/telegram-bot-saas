{
  "name": "telegizer-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@sentry/react": "^8.55.1",
    "axios": "^1.6.2",
    "gsap": "^3.15.1",
    "posthog-js": "^1.372.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-joyride": "^3.1.0",
    "react-router-dom": "^7.18.7",
    "react-toastify": "^9.1.3",
    "recharts": "^2.10.1"
  },
  "scripts": {
    "start": "vite",
    "build": "node scripts/generate-sitemap.js && node scripts/generate-og-image.js && node scripts/build.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "og-image": "node scripts/generate-og-image.js",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:build": "node e2e/build.js",
    "preview": "vite preview",
    "test:watch": "vitest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@emotion/server": "^11.11.0",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "serve": "^14.2.4",
    "sharp": "^0.35.5",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": "22.x"
  }
}
